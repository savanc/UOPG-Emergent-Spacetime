import PositiveGeometryEmergentSpaceTime.Alignment.Sanity.Jord1Bridge

/-!
# JORD-1: the derivation algebra of `h3(O)` has dimension 52

`derSub` is the ℚ-subspace of 27×27 matrices `D` with `IsDer D` (the derivation condition on all basis
triples, from the Fano-defined table `T1s`). We prove `Module.finrank ℚ derSub = 52` by a linear
equivalence `derSub ≃ ℚ^52`, reading off 52 chosen entries `Fr`.

* Injective (upper bound): a peeling certificate `steps`. Each step uses one derivation constraint row
  in which every entry except one is already known to vanish; the remaining entry has a nonzero
  coefficient, so it vanishes too. Starting from the 52 entries `Fr`, the steps reach all 729 entries
  (`peel_ok`, kernel-checked).
* Surjective (lower bound): 52 explicit integer derivations `Bm[t]` (each checked by `derS`) whose
  `Fr`-entries are `dB[t]·δ`.
-/

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

namespace PositiveGeometryEmergentSpaceTime.Alignment.Sanity.Jord1Der
open Matrix PositiveGeometryEmergentSpaceTime.Jord1 PositiveGeometryEmergentSpaceTime.LeanCert PositiveGeometryEmergentSpaceTime.LeanCert2 PositiveGeometryEmergentSpaceTime.Alignment.Sanity.Jord1Sanity
  PositiveGeometryEmergentSpaceTime.Alignment.Sanity.Jord1Bridge

/-- Rational 27×27 matrices. -/
abbrev Mat := Matrix (Fin 27) (Fin 27) ℚ

/-- Entry `u = 27a + b` of `D`, i.e. `D a b` (zero out of range). -/
def Dv (D : Mat) (u : ℕ) : ℚ := if h : u < 729 then D ⟨u / 27, by omega⟩ ⟨u % 27, by omega⟩ else 0

/-- `Dv` recovers matrix entries. -/
theorem Dv_mk (D : Mat) (a b : Fin 27) : Dv D (27 * a + b) = D a b := by
  have ha := a.isLt; have hb := b.isLt
  unfold Dv; rw [dif_pos (by omega)]
  congr 1 <;> apply Fin.ext <;> simp only [] <;> omega

/-- `Dv` is additive. -/
theorem Dv_add (A B : Mat) (u : ℕ) : Dv (A + B) u = Dv A u + Dv B u := by
  unfold Dv; split_ifs <;> simp

/-- `Dv` is homogeneous. -/
theorem Dv_smul (c : ℚ) (A : Mat) (u : ℕ) : Dv (c • A) u = c * Dv A u := by
  unfold Dv; split_ifs <;> simp

/-- Sparse derivation constraint row `(i, j, k)` over the unknowns `u = 27a + b`. -/
def rowS (i j k : ℕ) : List (ℕ × ℤ) :=
  ((T1s.getD i []).getD j []).map (fun p => (27 * k + p.1, p.2)) ++
  ((T2s.getD j []).getD k []).map (fun p => (27 * p.1 + i, -p.2)) ++
  ((T2s.getD i []).getD k []).map (fun p => (27 * p.1 + j, -p.2))

/-- Value of a sparse row at `D`. -/
def rv (D : Mat) (r : List (ℕ × ℤ)) : ℚ := (r.map fun p => (p.2 : ℚ) * Dv D p.1).sum

theorem sum_neg_map {α : Type} (L : List α) (f : α → ℚ) : (L.map fun p => -f p).sum = -(L.map f).sum := by
  induction L with
  | nil => simp
  | cons a L ih => simp only [List.map_cons, List.sum_cons, ih]; ring

/-- Every constraint row vanishes at a derivation. -/
theorem rv_rowS (D : Mat) (hD : IsDer D) (i j k : Fin 27) : rv D (rowS i j k) = 0 := by
  have hi := idx_ok_true; have h2 := T2s_ok_true; have hc := comm_ok_true
  simp only [idx_ok, T2s_ok, comm_ok, allFin_iff, Bool.and_eq_true, beq_iff_eq] at hi h2 hc
  have e1 : rv D (((T1s.getD i []).getD j []).map (fun p => (27 * (k : ℕ) + p.1, p.2))) =
      ∑ l : Fin 27, (bc i j l : ℚ) * D k l := by
    rw [show (∑ l : Fin 27, (bc i j l : ℚ) * D k l) = ∑ l : Fin 27,
        (coefS ((T1s.getD i []).getD j []) l : ℚ) * Dv D (27 * (k : ℕ) + (l : ℕ)) from
        Finset.sum_congr rfl fun l _ => by simp only [bc, Dv_mk]]
    rw [sum_coefS _ (hi i j).1 (fun n => Dv D (27 * (k : ℕ) + n))]
    simp [rv, List.map_map, Function.comp_def]
  have e2 : rv D (((T2s.getD j []).getD k []).map (fun p => (27 * p.1 + (i : ℕ), -p.2))) =
      -∑ l : Fin 27, D l i * (bc l j k : ℚ) := by
    rw [show (∑ l : Fin 27, D l i * (bc l j k : ℚ)) = ∑ l : Fin 27,
        (coefS ((T2s.getD j []).getD k []) l : ℚ) * Dv D (27 * (l : ℕ) + (i : ℕ)) from
        Finset.sum_congr rfl fun l _ => by simp only [h2 j k l, Dv_mk]; ring]
    rw [sum_coefS _ (hi j k).2 (fun n => Dv D (27 * n + (i : ℕ))), ← sum_neg_map]
    simp [rv, List.map_map, Function.comp_def]
  have e3 : rv D (((T2s.getD i []).getD k []).map (fun p => (27 * p.1 + (j : ℕ), -p.2))) =
      -∑ l : Fin 27, D l j * (bc i l k : ℚ) := by
    rw [show (∑ l : Fin 27, D l j * (bc i l k : ℚ)) = ∑ l : Fin 27,
        (coefS ((T2s.getD i []).getD k []) l : ℚ) * Dv D (27 * (l : ℕ) + (j : ℕ)) from
        Finset.sum_congr rfl fun l _ => by simp only [h2 i k l, hc l i k, Dv_mk]; ring]
    rw [sum_coefS _ (hi i k).2 (fun n => Dv D (27 * n + (j : ℕ))), ← sum_neg_map]
    simp [rv, List.map_map, Function.comp_def]
  have ea : ∀ u v : List (ℕ × ℤ), rv D (u ++ v) = rv D u + rv D v := by
    intro u v; simp [rv]
  rw [rowS, ea, ea, e1, e2, e3, hD i j k]; ring

/-- A row whose other entries vanish pins the remaining one. -/
theorem rv_single (D : Mat) (r : List (ℕ × ℤ)) (u : ℕ) (h : ∀ p ∈ r, p.1 ≠ u → Dv D p.1 = 0) :
    rv D r = (coefS r u : ℚ) * Dv D u := by
  induction r with
  | nil => simp [rv, coefS]
  | cons p r ih =>
    have ih' := ih (fun q hq hne => h q (List.mem_cons_of_mem _ hq) hne)
    simp only [rv, List.map_cons, List.sum_cons] at ih' ⊢
    rw [ih', coefS]
    by_cases hp : p.1 = u
    · rw [if_pos hp, hp]; push_cast; ring
    · rw [if_neg hp, h p (by simp) hp]; simp

/-- Peeling checker: each step's row has all entries known except the target, whose coefficient is
nonzero; at the end all 729 entries are known. -/
def peelOK : List ℕ → List (ℕ × ℕ × ℕ × ℕ) → Bool
  | known, [] => (List.range 729).all (fun u => known.contains u)
  | known, (i, j, k, u) :: rest =>
    decide (i < 27) && decide (j < 27) && decide (k < 27) && (coefS (rowS i j k) u != 0) &&
      (rowS i j k).all (fun p => p.1 == u || known.contains p.1) && peelOK (u :: known) rest

/-- Soundness of the peeling checker. -/
theorem peel_sound (D : Mat) (hD : IsDer D) : ∀ (known : List ℕ) (st : List (ℕ × ℕ × ℕ × ℕ)),
    peelOK known st = true → (∀ v ∈ known, Dv D v = 0) → ∀ u < 729, Dv D u = 0
  | known, [], h, hk => by
    intro u hu
    simp only [peelOK, List.all_eq_true, List.mem_range, List.contains_iff_mem] at h
    exact hk u (h u hu)
  | known, (i, j, k, u) :: rest, h, hk => by
    simp only [peelOK, Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq, List.all_eq_true,
      Bool.or_eq_true, beq_iff_eq, List.contains_iff_mem] at h
    obtain ⟨⟨⟨⟨⟨hi, hj⟩, hk'⟩, hc⟩, hall⟩, hrest⟩ := h
    refine peel_sound D hD (u :: known) rest hrest ?_
    have hz : Dv D u = 0 := by
      have e : rv D (rowS i j k) = 0 := rv_rowS D hD ⟨i, hi⟩ ⟨j, hj⟩ ⟨k, hk'⟩
      rw [rv_single D _ u (fun p hp hne => hk _ ((hall p hp).resolve_left hne))] at e
      exact (mul_eq_zero.mp e).resolve_left (by exact_mod_cast hc)
    intro v hv
    rcases List.mem_cons.mp hv with rfl | hv
    · exact hz
    · exact hk v hv

--DATA--

/-- Basis derivation `t`, integer rows. -/
def Bt (t : ℕ) : List (List ℤ) := Bm.getD t []
/-- Basis derivation `t`, integer columns. -/
def BCt (t : ℕ) : List (List ℤ) := BmC.getD t []
/-- Integer entry `u = 27a + b` of a row list. -/
def Dvz (L : List (List ℤ)) (u : ℕ) : ℤ := (L.getD (u / 27) []).getD (u % 27) 0

/-- Checks for basis derivation `t`: transpose, derivation, `Fr`-entries `dB[t]·δ`, `dB[t] > 0`. -/
def derOK (t : ℕ) : Bool :=
  tposL 27 27 (Bt t) (BCt t) && derS (Bt t) (BCt t) &&
    (List.range 52).all (fun s => Dvz (Bt t) (Fr.getD s 0) == if s = t then (dB.getD t 1 : ℤ) else 0) &&
    decide (0 < dB.getD t 1)

/-- The peeling certificate passes (kernel decision). -/
theorem peel_ok : peelOK Fr steps = true := by decide +kernel
/-- `Fr` has 52 entries, all below 729. -/
theorem Fr_ok : Fr.length = 52 ∧ Fr.all (fun u => decide (u < 729)) = true := by decide +kernel

--DERS--

/-- `Dv` of an integer matrix. -/
theorem Dv_cq (L : List (List ℤ)) (u : ℕ) (hu : u < 729) :
    Dv (cq (rowsM 27 27 L)) u = (Dvz L u : ℚ) := by
  simp [Dv, hu, cq, rowsM, Dvz]

/-- The derivations of `h3(O)` over ℚ, as a subspace of 27×27 matrices. -/
def derSub : Submodule ℚ Mat where
  carrier := {D | IsDer D}
  add_mem' := by
    intro A B hA hB i j k
    have h1 := hA i j k; have h2 := hB i j k
    simp only [Matrix.add_apply, mul_add, add_mul, Finset.sum_add_distrib]
    linarith
  zero_mem' := by intro i j k; simp
  smul_mem' := by
    intro c A hA i j k
    have h := hA i j k
    simp only [Matrix.smul_apply, smul_eq_mul]
    calc ∑ l : Fin 27, (bc i j l : ℚ) * (c * A k l) = c * ∑ l : Fin 27, (bc i j l : ℚ) * A k l := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
      _ = c * (∑ l : Fin 27, A l i * (bc l j k : ℚ) + ∑ l : Fin 27, A l j * (bc i l k : ℚ)) := by rw [h]
      _ = _ := by
          rw [mul_add, Finset.mul_sum, Finset.mul_sum]
          congr 1 <;> exact Finset.sum_congr rfl fun _ _ => by ring

/-- Reading off the 52 entries `Fr`. -/
def phi : derSub →ₗ[ℚ] (Fin 52 → ℚ) where
  toFun D := fun t => Dv D.1 (Fr.getD t 0)
  map_add' A B := by funext t; simp [Dv_add]
  map_smul' c A := by funext t; simp [Dv_smul]

theorem phi_injective : Function.Injective phi := by
  refine (injective_iff_map_eq_zero phi).2 fun D hD => ?_
  have hF : ∀ v ∈ Fr, Dv D.1 v = 0 := by
    intro v hv
    obtain ⟨n, hn, rfl⟩ := List.mem_iff_getElem.1 hv
    have hn' : n < 52 := Fr_ok.1 ▸ hn
    have := congrFun hD ⟨n, hn'⟩
    simpa [phi, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hn] using this
  have hall := peel_sound D.1 D.2 Fr steps peel_ok hF
  apply Subtype.ext
  ext a b
  have := hall (27 * a + b) (by omega)
  rw [Dv_mk] at this
  simpa using this

/-- Basis derivation `t` as an element of `derSub`. -/
def G (t : Fin 52) : derSub :=
  ⟨(1 / (dB.getD t 1 : ℚ)) • cq (rowsM 27 27 (Bt t)), derSub.smul_mem _ (by
    have h := derOK_all t
    simp only [derOK, Bool.and_eq_true] at h
    exact isDer_of_derS h.1.1.1 h.1.1.2)⟩

theorem phi_G (t : Fin 52) : phi (G t) = Pi.single t 1 := by
  have h := derOK_all t
  simp only [derOK, Bool.and_eq_true, List.all_eq_true, List.mem_range, beq_iff_eq,
    decide_eq_true_eq] at h
  have hlt := Fr_ok.2
  simp only [List.all_eq_true, decide_eq_true_eq] at hlt
  funext s
  have hs : Fr.getD s 0 < 729 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [Fr_ok.1]; exact s.isLt)]
    exact hlt _ (List.getElem_mem _)
  have hd : (0 : ℚ) < (dB.getD t 1 : ℚ) := by exact_mod_cast h.2
  simp only [phi, G, LinearMap.coe_mk, AddHom.coe_mk, Dv_smul, Dv_cq _ _ hs, h.1.2 s s.isLt]
  by_cases hst : s = t
  · subst hst
    have hd' := hd.ne'
    simp only [List.getD_eq_getElem?_getD] at hd'
    simp [hd']
  · have : (s : ℕ) ≠ t := fun e => hst (Fin.ext e)
    simp [this, hst]

theorem phi_surjective : Function.Surjective phi := by
  intro v
  refine ⟨∑ t : Fin 52, v t • G t, ?_⟩
  simp only [map_sum, map_smul, phi_G]
  funext s
  simp [Finset.sum_apply, Pi.single_apply]

/-- **JORD-1:** `dim_ℚ Der(h3(O)) = 52`. -/
theorem finrank_der : Module.finrank ℚ derSub = 52 := by
  rw [(LinearEquiv.ofBijective phi ⟨phi_injective, phi_surjective⟩).finrank_eq]
  simp

/-- Planted: dropping the last peeling step leaves the check unfinished. -/
theorem planted_peel_short : peelOK Fr steps.dropLast = false := by decide +kernel

