import PositiveGeometryEmergentSpaceTime
open Lean Elab Command Meta

/-! R4-DM v3 planted cases (locked, prereg/R4-DM3-2026-10-20.md). NOT part of the PositiveGeometryEmergentSpaceTime library. The 16 v2 cases
(`sims/r4dm2/planted/R4DM2Planted.lean`, namespace renamed) plus v3 cases for E1 (charge-normalisation literals:
integer ×6, Y/2), E2 (N_c-symbolic normalisation) and E3 (D1 tightened). Exported with the export block
byte-identical to `sims/r4dm/R4DMExport.lean` to `sims/r4dm3/planted/planted_decls.jsonl`. Module names:
`PositiveGeometryEmergentSpaceTime.R4DM3Planted` (GEOMETRY-PG) and, for names under `PositiveGeometryEmergentSpaceTime.R4DM3Planted.Mixed`, `PositiveGeometryEmergentSpaceTime.R4DM3PlantedMixed`
(MIXED/TEST, default SM-INPUT, `geoMap` → GEOMETRY-PG).
Run from `lean/`: `lake env lean ../sims/r4dm3/planted/R4DM3Planted.lean`. -/

namespace PositiveGeometryEmergentSpaceTime.R4DM3Planted
open PositiveGeometryEmergentSpaceTime.IsingTiling8

def yQgeo : ℚ := ogSignature 0 / 6

theorem yQgeo_eq : yQgeo = 1 / 6 := by
  simp [yQgeo, ogSignature]

theorem planted_genuine :
    yQgeo = 1 / 6 ∧ PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQgeo (-4 * yQgeo) (2 * yQgeo) (-3 * yQgeo) (6 * yQgeo) := by
  refine ⟨yQgeo_eq, ?_⟩
  rw [yQgeo_eq]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

theorem planted_conditional (y : ℚ) (h : y * 6 = ogSignature 0) :
    y = 1 / 6 ∧ PositiveGeometryEmergentSpaceTime.STRUCT1.ACC y (-4 * y) (2 * y) (-3 * y) (6 * y) := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  have hy : y = 1 / 6 := by rw [h0] at h; linarith
  refine ⟨hy, ?_⟩
  rw [hy]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

theorem planted_smuggled_literal (y : ℚ) (_hg : y * 6 = ogSignature 0) (h : y = 1 / 6) :
    y = 1 / 6 ∧ PositiveGeometryEmergentSpaceTime.STRUCT1.ACC y (-4 * y) (2 * y) (-3 * y) (6 * y) := by
  refine ⟨h, ?_⟩
  rw [h]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

theorem planted_smuggled_acc (yQ yu yd yL ye : ℚ) (h : PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQ yu yd yL ye)
    (hg : ogSignature 0 = 1) : PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQ yu yd yL ye ∧ ogSignature 0 = 1 :=
  ⟨h, hg⟩

theorem planted_smuggled_nc (N_c : ℚ) (h : N_c = 3) : N_c * ogSignature 0 = 3 := by
  rw [h]; simp [ogSignature]

theorem planted_fed : ogSignature 0 = 1 ∧ PositiveGeometryEmergentSpaceTime.STRUCT1.ACC (1 / 6) (-2 / 3) (1 / 3) (-1 / 2) 1 :=
  ⟨by simp [ogSignature], PositiveGeometryEmergentSpaceTime.STRUCT1.sm_is_anomaly_free⟩

theorem planted_nonconstraining (yQ : ℚ) : yQ * ogSignature 0 = yQ := by
  simp [ogSignature]

theorem planted_nogeo : PositiveGeometryEmergentSpaceTime.STRUCT1.ACC (1 / 6) (-2 / 3) (1 / 3) (-1 / 2) 1 := by
  unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

/-! D1/D2: a structure carrying SM couplings as fields (like `BR5p.Inv`); `PInv.a`, `PInv.lam3` are SM-var constants. -/
structure PInv where
  a : ℚ
  lam3 : ℚ

/-- D1-identity: field reads on a bound `x` with no hypothesis — must be NON-CONSTRAINING (v1 said DERIVED). -/
theorem planted_d1_identity (x : PInv) : x.a * ogSignature 0 = x.a := by
  simp [ogSignature]

/-- D1-control: a geometric hypothesis on the bound `x` fixes the field — must stay DERIVED/CONDITIONAL/PG. -/
theorem planted_d1_conditional (x : PInv) (h : x.a * 6 = ogSignature 0) : x.a = 1 / 6 := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  rw [h0] at h; linarith

/-! D2: `PInv.mk.inj`, `PInv.mk.injEq`, `PInv.mk.sizeOf_spec` are generated by Lean — must be AUTO-GENERATED. -/

/-! D3: a MIXED/TEST module (default SM-INPUT) with an override `geoMap` → GEOMETRY-PG; the suffixed lemma
`geoMap_one` must inherit the override. -/
namespace Mixed
def geoMap (t : ℚ) : ℚ := t * ogSignature 0
theorem geoMap_one : geoMap 1 = 1 := by simp [geoMap, ogSignature]
end Mixed

def yQgeo3 : ℚ := Mixed.geoMap 1 / 6

/-- D3-case: the proof uses the suffixed override lemma `Mixed.geoMap_one` — must be DERIVED/UNCONDITIONAL/PG
(v1 said SM-INPUT-FED because `geoMap_one` kept the module's SM-INPUT default). -/
theorem planted_d3 : yQgeo3 = 1 / 6 ∧
    PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQgeo3 (-4 * yQgeo3) (2 * yQgeo3) (-3 * yQgeo3) (6 * yQgeo3) := by
  have e : yQgeo3 = 1 / 6 := by rw [yQgeo3, Mixed.geoMap_one]
  refine ⟨e, ?_⟩
  rw [e]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num


/-! ===== v3 cases (prereg/R4-DM3-2026-10-20.md) ===== -/

/-! E1 (charge-normalisation literals). Integer ×6 form: the SM ratio `yu = −4·yQ` typed into a hypothesis that
also mentions a geometry constant (so v2's test (b) does not fire and v2's literal list, fractions only, misses it).
Must be SMUGGLED (v2 rules: DERIVED/CONDITIONAL/PG). -/
theorem planted_smuggled_int (yQ yu : ℚ) (h : yu = -4 * yQ * ogSignature 0) :
    PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQ yu (2 * yQ) (-3 * yQ) (6 * yQ) := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  rw [h0, mul_one] at h; subst h; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; refine ⟨by ring, by ring, by ring, by ring⟩

/-- E1, Y/2 convention (Q = T₃ + Y/2): the right-handed up-quark value `4/3` typed into a hypothesis. Must be SMUGGLED
(v2 rules: DERIVED/CONDITIONAL/PG; `4/3` was not on v2's list). -/
theorem planted_smuggled_half (yu : ℚ) (h : yu = 4 / 3 * ogSignature 0) : yu * 3 = 4 := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  rw [h0] at h; rw [h]; norm_num

/-- E2 (N_c-symbolic normalisation `yQ = 1/(2N_c)`, as in FRMU): `2·N_c·yQ` tied to a geometry constant. Must be
SMUGGLED (v2 rules: DERIVED/CONDITIONAL/PG: no literal, geometry present). -/
theorem planted_smuggled_ncsym (N_c yQ : ℚ) (h : 2 * N_c * yQ = ogSignature 0) : 2 * N_c * yQ = 1 := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  rw [h, h0]

/-! Genuine controls for E1/E2: integer-form charges that come out of a geometry constant, with no SM value typed
into any hypothesis. Must stay DERIVED under every v3 rule. -/
def yQint : ℚ := ogSignature 0

theorem planted_genuine_int : yQint = 1 ∧
    PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQint (-4 * yQint) (2 * yQint) (-3 * yQint) (6 * yQint) := by
  have e : yQint = 1 := by simp [yQint, ogSignature]
  refine ⟨e, ?_⟩
  rw [e]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

theorem planted_conditional_int (yQ : ℚ) (h : yQ = ogSignature 0) :
    yQ = 1 ∧ PositiveGeometryEmergentSpaceTime.STRUCT1.ACC yQ (-4 * yQ) (2 * yQ) (-3 * yQ) (6 * yQ) := by
  have h0 : ogSignature 0 = 1 := by simp [ogSignature]
  have e : yQ = 1 := by rw [h, h0]
  refine ⟨e, ?_⟩
  rw [e]; unfold PositiveGeometryEmergentSpaceTime.STRUCT1.ACC; norm_num

/-! E3 (D1 tightened): a structure with coupling fields `a`, `lam3` (SM-var constants) and a kinematic field `k`
(not SM). A bound `x : PInv3` makes a statement SM-structure only if the conclusion reads a coupling/charge field. -/
structure PInv3 where
  a : ℚ
  lam3 : ℚ
  k : ℚ

/-- E3: conclusion reads only the kinematic field. Must be NOT-SM-STRUCTURE (v2 D1: NON-CONSTRAINING). -/
theorem planted_d1_kin (x : PInv3) : x.k * ogSignature 0 = x.k := by
  simp [ogSignature]

/-- E3: couplings only in a hypothesis, conclusion kinematic (the `BR5p.built_zero_of_gauge` shape). Must be
NOT-SM-STRUCTURE (v2 D1: SMUGGLED). -/
theorem planted_d1_zero (x : PInv3) (_h : x.a ^ 2 = x.lam3 ^ 2) : x.k * ogSignature 0 = x.k := by
  simp [ogSignature]

/-- E3 control: the conclusion reads a coupling field. Must stay NON-CONSTRAINING (v2 D1 behaviour kept). -/
theorem planted_d1_field (x : PInv3) : x.a * ogSignature 0 = x.a := by
  simp [ogSignature]

end PositiveGeometryEmergentSpaceTime.R4DM3Planted

