namespace PositiveGeometryEmergentSpaceTime.HgDim2P4
open PositiveGeometryEmergentSpaceTime.HgDim2

abbrev V := Fin 24
def perms : List (List Nat) := [[0, 1, 2, 3], [0, 1, 3, 2], [0, 2, 1, 3], [0, 2, 3, 1], [0, 3, 1, 2], [0, 3, 2, 1], [1, 0, 2, 3], [1, 0, 3, 2], [1, 2, 0, 3], [1, 2, 3, 0], [1, 3, 0, 2], [1, 3, 2, 0], [2, 0, 1, 3], [2, 0, 3, 1], [2, 1, 0, 3], [2, 1, 3, 0], [2, 3, 0, 1], [2, 3, 1, 0], [3, 0, 1, 2], [3, 0, 2, 1], [3, 1, 0, 2], [3, 1, 2, 0], [3, 2, 0, 1], [3, 2, 1, 0]]
def P (i : V) : List Nat := perms.getD i.val []
def nbrT : List (List Nat) := [[6, 2, 1], [7, 4, 0], [12, 0, 3], [13, 5, 2], [18, 1, 5], [19, 3, 4], [0, 8, 7], [1, 10, 6], [14, 6, 9], [15, 11, 8], [20, 7, 11], [21, 9, 10], [2, 14, 13], [3, 16, 12], [8, 12, 15], [9, 17, 14], [22, 13, 17], [23, 15, 16], [4, 20, 19], [5, 22, 18], [10, 18, 21], [11, 23, 20], [16, 19, 23], [17, 21, 22]]
def nbrs (i : V) : List V := (nbrT.getD i.val []).map fun j => (Fin.ofNat 24 j)
def adj (i j : V) : Bool := (nbrs i).contains j

theorem perms_length : perms.length = 24 := by decide +kernel
theorem perms_valid : ∀ i : V, (P i).length = 4 ∧ (List.range 4).all (fun v => (P i).contains v) = true := by decide +kernel
theorem rank_P : ∀ i : V, lehmer (P i) = i.val := by decide +kernel
theorem P_inj (i j : V) (h : P i = P j) : i = j := Fin.ext (by rw [← rank_P i, ← rank_P j, h])
theorem nbr_spec : ∀ i : V, (nbrs i).length = 3 ∧ ∀ k : Fin 3, P ((nbrs i).getD k.val 0) = swapAt (P i) k.val := by decide +kernel

/-! ### Label 0: edge (e, s_0), h = 1, cost 4, κ = 0/4 -/
def NA_0 : List V := [0, 6, 2, 1]
def NB_0 : List V := [6, 0, 8, 7]
def ws_0 : List (V × List V) := [(0, []), (6, []), (2, [12, 14, 8]), (1, [7])]
def phi_0 (i : V) : Int := phiInv 4 0 (P i)
theorem phi_0_lip : ∀ i : V, (nbrs i).all (fun j => decide (phi_0 i - phi_0 j ≤ 1)) = true := by decide +kernel
theorem phi_0_gap : (NA_0.map phi_0).sum - (NB_0.map phi_0).sum = 4 := by decide +kernel
theorem nbhd_0 : NA_0 = 0 :: nbrs 0 ∧ NB_0 = 6 :: nbrs 6 ∧ (nbrs 0).getD 0 0 = 6 := by decide +kernel
theorem ws_0_ok : (ws_0.all fun p => walkOk adj (p.1 :: p.2)) = true ∧ (ws_0.map Prod.fst).Perm NA_0 ∧
    (ws_0.map fun p => fin p.1 p.2).Perm NB_0 ∧ (ws_0.map fun p => (p.2.length : Int)).sum = 4 := by
  refine ⟨by decide +kernel, ?_, ?_, by decide +kernel⟩ <;> exact List.perm_iff_count.mpr (by decide +kernel)
theorem edge4_0 : adj 0 6 = true ∧ hexCount 4 0 = 1 ∧
    (∃ ws : List (V × List V), (∀ p ∈ ws, walkOk adj (p.1 :: p.2) = true) ∧ (ws.map Prod.fst).Perm NA_0 ∧
      (ws.map fun p => fin p.1 p.2).Perm NB_0 ∧ (ws.map fun p => (p.2.length : Int)).sum = 4) ∧
    (∀ ws : List (V × List V), (∀ p ∈ ws, walkOk adj (p.1 :: p.2) = true) → (ws.map Prod.fst).Perm NA_0 →
      (ws.map fun p => fin p.1 p.2).Perm NB_0 → 4 ≤ (ws.map fun p => (p.2.length : Int)).sum) := by
  obtain ⟨h1, h2, h3, h4⟩ := ws_0_ok
  refine ⟨by decide +kernel, by decide +kernel, ⟨ws_0, fun p hp => List.all_eq_true.mp h1 p hp, h2, h3, h4⟩, ?_⟩
  intro ws hw hA hB
  have hl : ∀ i j : V, adj i j = true → phi_0 i - phi_0 j ≤ 1 := by
    intro i j hij
    have := List.all_eq_true.mp (phi_0_lip i) j (by simpa [adj] using hij)
    simpa using this
  have := cost_lower adj phi_0 hl ws hw
  rw [(hA.map phi_0).sum_eq, (hB.map phi_0).sum_eq, phi_0_gap] at this
  exact this

