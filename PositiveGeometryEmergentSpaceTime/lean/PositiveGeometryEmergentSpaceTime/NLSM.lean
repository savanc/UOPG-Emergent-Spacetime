/-
M2d — from Tr(φ³) to pions by the δ-shift.
Sources: [N] Arkani-Hamed, Cao, Dong, Figueiredo, He, "NLSM ⊂ Tr(φ³)", arXiv:2401.05483, eqs. (1)–(2);
[H] same authors, "Hidden zeros for particle/string amplitudes and the unity of colored scalars, pions and
gluons", arXiv:2312.16282, §3 (eqs. 3.1, 3.3, 3.5), §4 (eqs. 4.3, 4.4).
Shift: X_{e,e} ↦ X + δ, X_{o,o} ↦ X − δ, X_{o,e} unchanged.

Labels: LIMIT = a genuine `Filter.Tendsto … atTop`; IDENTITY = an exact rational-function identity.
Every LIMIT is proved by writing δ^k · A(X̃) = N(δ⁻¹)/D(δ⁻¹) eventually, with N, D polynomials, D(0) ≠ 0.
That N has no negative powers of ε = δ⁻¹ *is* the cancellation of the O(δ⁻ᵐ) terms.
N was generated by `scripts/m2d_nlsm_check.py`'s companion and is checked here by `field_simp; ring`,
so nothing is trusted from the script.
-/
import Mathlib
import PositiveGeometryEmergentSpaceTime.Associahedron

open Filter Topology

namespace PositiveGeometryEmergentSpaceTime.NLSM


/-- Limit at +∞ through ε = δ⁻¹. -/
theorem tendsto_atTop_of_inv {F g : ℝ → ℝ} (hg : ContinuousAt g 0)
    (hF : ∀ᶠ δ in atTop, F δ = g δ⁻¹) : Tendsto F atTop (𝓝 (g 0)) :=
  (hg.tendsto.comp tendsto_inv_atTop_zero).congr' (hF.mono fun _ h => h.symm)

/-! ## n = 4 -/

/-- Tr(φ³) 4-point amplitude. -/
noncomputable def A4 (X13 X24 : ℝ) : ℝ := 1 / X13 + 1 / X24
/-- NLSM 4-point amplitude in [H]'s normalisation (eq. 4.4). -/
def A4N (X13 X24 : ℝ) : ℝ := X13 + X24
/-- IDENTITY ([H] eq. 4.4): A4^NLSM = c13 (here c13 = X13 + X24 − X14 − X23 with X14 = X23 = 0), so
  it vanishes at c13 = 0. -/
theorem nlsm4_eq_c13 (X13 X24 : ℝ) : A4N X13 X24 = X13 + X24 - 0 - 0 := by simp [A4N]

/-- LIMIT ([N] eq. 2, n = 4 example): δ² · A4(X13 − δ, X24 + δ) → −(X13 + X24) = −A4^NLSM. -/
theorem shift4_limit {X13 X24 : ℝ}  :
    Tendsto (fun δ : ℝ => δ ^ 2 * A4 (X13 - δ) (X24 + δ)) atTop (𝓝 (-(X13 + X24))) := by
  have key := tendsto_atTop_of_inv (F := fun δ : ℝ => δ ^ 2 * A4 (X13 - δ) (X24 + δ))
    (g := fun e : ℝ => (-X13 - X24) / (((-X13) * e + 1) * (X24 * e + 1))) ?_ ?_
  · convert key using 2
    norm_num
    try ring
  · apply ContinuousAt.div (by fun_prop) (by fun_prop)
    simp [*]
  · filter_upwards [eventually_gt_atTop (|X13| + |X24| + 1)] with δ hδ
    have hδ0 : δ ≠ 0 := by
      intro h; rw [h] at hδ; linarith [abs_nonneg X13, abs_nonneg X24]
    have nX13 : X13 - δ ≠ 0 := by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24]
    have nX24 : X24 + δ ≠ 0 := by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24]
    have fX13 : ((-X13) * δ⁻¹ + 1) ≠ 0 := by
      rw [show ((-X13) * δ⁻¹ + 1) = (δ - X13) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24]) hδ0
    have fX24 : (X24 * δ⁻¹ + 1) ≠ 0 := by
      rw [show (X24 * δ⁻¹ + 1) = (δ + X24) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24]) hδ0
    have hD : ((-X13) * δ⁻¹ + 1) * (X24 * δ⁻¹ + 1) ≠ 0 := by apply_rules [mul_ne_zero]
    show _ = _ / _
    rw [eq_div_iff hD]
    simp only [A4]
    field_simp
    ring
/-! ## n = 5 (odd): not a pion amplitude -/

/-- m5 on the full 5-dim kinematic space (free planar variables), [H] eq. 3.1. -/
noncomputable def m5f (X13 X14 X24 X25 X35 : ℝ) : ℝ := 1 / (X13 * X14) + 1 / (X13 * X35) + 1 / (X14 * X24) + 1 / (X24 * X25) + 1 / (X25 * X35)

/-- M2c's m5 on H is m5f restricted to H. -/
theorem m5_eq_m5f (c13 c14 c24 x y : ℝ) :
    PositiveGeometryEmergentSpaceTime.Assoc.m5 c13 c14 c24 x y = m5f x y (y - x + c13) (c13 + c14 - x) (c14 + c24 - y) := by
  simp only [PositiveGeometryEmergentSpaceTime.Assoc.m5, m5f]; ring

/-- Leading large-δ coefficient of the shifted 5-point amplitude (a mixed π/φ object, X⁰). -/
noncomputable def L5 (X13 X14 X24 X25 X35 : ℝ) : ℝ := 1 - (X13 + X24) / X14 - (X24 + X35) / X25

/-- LIMIT: δ · m5(X̃) → 0. The O(δ⁻¹) terms cancel; there is no pion-order term. -/
theorem shift5_limit_one {X13 X14 X24 X25 X35 : ℝ} (h14 : X14 ≠ 0) (h25 : X25 ≠ 0) :
    Tendsto (fun δ : ℝ => δ ^ 1 * m5f (X13 - δ) X14 (X24 + δ) X25 (X35 - δ)) atTop (𝓝 (0)) := by
  have key := tendsto_atTop_of_inv (F := fun δ : ℝ => δ ^ 1 * m5f (X13 - δ) X14 (X24 + δ) X25 (X35 - δ))
    (g := fun e : ℝ => (X13*X14*X24*e^2 + X13*X14*X35*e^2 + X13*X25*X35*e^2 - X13*X25*e + X14*X24*X25*e^2 - X14*X24*e + X14*X25*e - X14*X35*e + X24*X25*X35*e^2 - X24*X25*e) / (X14 * X25 * ((-X13) * e + 1) * (X24 * e + 1) * ((-X35) * e + 1))) ?_ ?_
  · convert key using 2
    norm_num
    try ring
  · apply ContinuousAt.div (by fun_prop) (by fun_prop)
    simp [*]
  · filter_upwards [eventually_gt_atTop (|X13| + |X24| + |X35| + 1)] with δ hδ
    have hδ0 : δ ≠ 0 := by
      intro h; rw [h] at hδ; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX13 : X13 - δ ≠ 0 := by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX24 : X24 + δ ≠ 0 := by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX35 : X35 - δ ≠ 0 := by intro h; have := le_abs_self X35; have := neg_abs_le X35; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have fX13 : ((-X13) * δ⁻¹ + 1) ≠ 0 := by
      rw [show ((-X13) * δ⁻¹ + 1) = (δ - X13) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have fX24 : (X24 * δ⁻¹ + 1) ≠ 0 := by
      rw [show (X24 * δ⁻¹ + 1) = (δ + X24) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have fX35 : ((-X35) * δ⁻¹ + 1) ≠ 0 := by
      rw [show ((-X35) * δ⁻¹ + 1) = (δ - X35) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X35; have := neg_abs_le X35; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have hD : X14 * X25 * ((-X13) * δ⁻¹ + 1) * (X24 * δ⁻¹ + 1) * ((-X35) * δ⁻¹ + 1) ≠ 0 := by apply_rules [mul_ne_zero]
    show _ = _ / _
    rw [eq_div_iff hD]
    simp only [m5f]
    field_simp
    ring

/-- LIMIT: δ² · m5(X̃) → L5, with poles only at the (o,e) chords X14, X25. -/
theorem shift5_limit_two {X13 X14 X24 X25 X35 : ℝ} (h14 : X14 ≠ 0) (h25 : X25 ≠ 0) :
    Tendsto (fun δ : ℝ => δ ^ 2 * m5f (X13 - δ) X14 (X24 + δ) X25 (X35 - δ)) atTop (𝓝 (L5 X13 X14 X24 X25 X35)) := by
  have key := tendsto_atTop_of_inv (F := fun δ : ℝ => δ ^ 2 * m5f (X13 - δ) X14 (X24 + δ) X25 (X35 - δ))
    (g := fun e : ℝ => (X13*X14*X24*e + X13*X14*X35*e + X13*X25*X35*e - X13*X25 + X14*X24*X25*e - X14*X24 + X14*X25 - X14*X35 + X24*X25*X35*e - X24*X25) / (X14 * X25 * ((-X13) * e + 1) * (X24 * e + 1) * ((-X35) * e + 1))) ?_ ?_
  · convert key using 2
    simp only [L5]; field_simp; ring
  · apply ContinuousAt.div (by fun_prop) (by fun_prop)
    simp [*]
  · filter_upwards [eventually_gt_atTop (|X13| + |X24| + |X35| + 1)] with δ hδ
    have hδ0 : δ ≠ 0 := by
      intro h; rw [h] at hδ; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX13 : X13 - δ ≠ 0 := by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX24 : X24 + δ ≠ 0 := by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have nX35 : X35 - δ ≠ 0 := by intro h; have := le_abs_self X35; have := neg_abs_le X35; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]
    have fX13 : ((-X13) * δ⁻¹ + 1) ≠ 0 := by
      rw [show ((-X13) * δ⁻¹ + 1) = (δ - X13) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X13; have := neg_abs_le X13; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have fX24 : (X24 * δ⁻¹ + 1) ≠ 0 := by
      rw [show (X24 * δ⁻¹ + 1) = (δ + X24) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X24; have := neg_abs_le X24; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have fX35 : ((-X35) * δ⁻¹ + 1) ≠ 0 := by
      rw [show ((-X35) * δ⁻¹ + 1) = (δ - X35) / δ by field_simp; ring]
      exact div_ne_zero (by intro h; have := le_abs_self X35; have := neg_abs_le X35; linarith [abs_nonneg X13, abs_nonneg X24, abs_nonneg X35]) hδ0
    have hD : X14 * X25 * ((-X13) * δ⁻¹ + 1) * (X24 * δ⁻¹ + 1) * ((-X35) * δ⁻¹ + 1) ≠ 0 := by apply_rules [mul_ne_zero]
    show _ = _ / _
    rw [eq_div_iff hD]
    simp only [m5f]
    field_simp
    ring
/-- IDENTITY: under the shift, among the five c's only c14 = X14 + X25 − X24 moves (by −δ). -/
theorem shift5_c (δ X13 X14 X24 X25 X35 : ℝ) :
    ((X13 - δ) + (X24 + δ) - X14 = X13 + X24 - X14) ∧ (X14 + X25 - (X24 + δ) = X14 + X25 - X24 - δ) ∧
    ((X24 + δ) + (X35 - δ) - X25 = X24 + X35 - X25) ∧ (X25 + (X13 - δ) - (X35 - δ) = X25 + X13 - X35) ∧
    ((X35 - δ) + X14 - (X13 - δ) = X35 + X14 - X13) := by
  refine ⟨by ring, by ring, by ring, by ring, by ring⟩

/-! ## Hidden zeros and near-zero factorisation (n = 5) -/

/-- [H] §3.1.1 skinny-rectangle zero {c13, c14} = 0 in the full 5-dim kinematic space. -/
theorem m5f_zero_0 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0) (h35 : X35 ≠ 0)
    (hc0 : X13 - X14 + X24 = 0) (hc1 : X14 - X24 + X25 = 0) :
    m5f X13 X14 X24 X25 X35 = 0 := by
  have e0 : X13 = -X25 := by linarith
  have e1 : X14 = X24 - X25 := by linarith
  subst e0 e1
  simp only [m5f]
  field_simp
  ring

/-- [H] §3.1.1 skinny-rectangle zero {c24, c25} = 0 in the full 5-dim kinematic space. -/
theorem m5f_zero_1 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0) (h35 : X35 ≠ 0)
    (hc0 : X24 - X25 + X35 = 0) (hc1 : X13 + X25 - X35 = 0) :
    m5f X13 X14 X24 X25 X35 = 0 := by
  have e0 : X13 = -X25 + X35 := by linarith
  have e1 : X24 = X25 - X35 := by linarith
  subst e0 e1
  simp only [m5f]
  field_simp
  ring

/-- [H] §3.1.1 skinny-rectangle zero {c35, c13} = 0 in the full 5-dim kinematic space. -/
theorem m5f_zero_2 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0) (h35 : X35 ≠ 0)
    (hc0 : -X13 + X14 + X35 = 0) (hc1 : X13 - X14 + X24 = 0) :
    m5f X13 X14 X24 X25 X35 = 0 := by
  have e0 : X13 = X14 + X35 := by linarith
  have e1 : X24 = -X35 := by linarith
  subst e0 e1
  simp only [m5f]
  field_simp
  ring

/-- [H] §3.1.1 skinny-rectangle zero {c14, c24} = 0 in the full 5-dim kinematic space. -/
theorem m5f_zero_3 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0) (h35 : X35 ≠ 0)
    (hc0 : X14 - X24 + X25 = 0) (hc1 : X24 - X25 + X35 = 0) :
    m5f X13 X14 X24 X25 X35 = 0 := by
  have e0 : X14 = -X35 := by linarith
  have e1 : X24 = X25 - X35 := by linarith
  subst e0 e1
  simp only [m5f]
  field_simp
  ring

/-- [H] §3.1.1 skinny-rectangle zero {c25, c35} = 0 in the full 5-dim kinematic space. -/
theorem m5f_zero_4 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0) (h35 : X35 ≠ 0)
    (hc0 : X13 + X25 - X35 = 0) (hc1 : -X13 + X14 + X35 = 0) :
    m5f X13 X14 X24 X25 X35 = 0 := by
  have e0 : X13 = -X25 + X35 := by linarith
  have e1 : X14 = -X25 := by linarith
  subst e0 e1
  simp only [m5f]
  field_simp
  ring

/-- IDENTITY ([H] eq. 3.3): near the zero, c14 = 0 ⇒ m5 = (1/X13 + 1/X25)(1/X14 + 1/X35). -/
theorem m5f_factor_c14 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0)
    (h35 : X35 ≠ 0) (hc : X14 + X25 - X24 = 0) :
    m5f X13 X14 X24 X25 X35 = (1 / X13 + 1 / X25) * (1 / X14 + 1 / X35) := by
  have e : X24 = X14 + X25 := by linarith
  subst e; simp only [m5f]; field_simp; ring

/-- IDENTITY ([H] eq. 3.5): c13 = 0 ⇒ m5 = (1/X13 + 1/X25)(1/X24 + 1/X35). -/
theorem m5f_factor_c13 {X13 X14 X24 X25 X35 : ℝ} (h13 : X13 ≠ 0) (h14 : X14 ≠ 0) (h24 : X24 ≠ 0) (h25 : X25 ≠ 0)
    (h35 : X35 ≠ 0) (hc : X13 + X24 - X14 = 0) :
    m5f X13 X14 X24 X25 X35 = (1 / X13 + 1 / X25) * (1 / X24 + 1 / X35) := by
  have e : X14 = X13 + X24 := by linarith
  subst e; simp only [m5f]; field_simp; ring

/-! ## n = 6 -/

/-- Tr(φ³) 6-point amplitude: the 14 planar cubic diagrams. -/
noncomputable def A6 (X13 X14 X15 X24 X25 X26 X35 X36 X46 : ℝ) : ℝ :=
  1 / (X13 * X14 * X15) + 1 / (X13 * X14 * X46) + 1 / (X13 * X15 * X35) + 1 / (X13 * X35 * X36) + 1 / (X13 * X36 * X46) + 1 / (X14 * X15 * X24) + 1 / (X14 * X24 * X46) + 1 / (X15 * X24 * X25) + 1 / (X15 * X25 * X35) + 1 / (X24 * X25 * X26) + 1 / (X24 * X26 * X46) + 1 / (X25 * X26 * X35) + 1 / (X26 * X35 * X36) + 1 / (X26 * X36 * X46)

/-- NLSM 6-point amplitude, [H] eq. 4.3: (X13+X24)(X15+X46)/X14 − X13 − X24 + (i → i+2) + (i → i+4). -/
noncomputable def A6N (X13 X14 X15 X24 X25 X26 X35 X36 X46 : ℝ) : ℝ :=
  ((X13 + X24) * (X15 + X46) / X14 - X13 - X24) + ((X35 + X46) * (X13 + X26) / X36 - X35 - X46)
    + ((X15 + X26) * (X35 + X24) / X25 - X15 - X26)

/-- LIMIT ([N] eq. 2, 2n = 6): δ⁴ · A6(X̃) → A6^NLSM ([H] eq. 4.3), sign +1 as pre-registered. The
  O(δ⁻¹), O(δ⁻²), O(δ⁻³) terms all cancel. -/
theorem shift6_limit {X13 X14 X15 X24 X25 X26 X35 X36 X46 : ℝ} (h14 : X14 ≠ 0) (h25 : X25 ≠ 0) (h36 : X36 ≠ 0) :
    Tendsto (fun δ : ℝ => δ ^ 4 * A6 (X13 - δ) X14 (X15 - δ) (X24 + δ) X25 (X26 + δ) (X35 - δ) X36 (X46 + δ)) atTop (𝓝 (A6N X13 X14 X15 X24 X25 X26 X35 X36 X46)) := by
  have key := tendsto_atTop_of_inv (F := fun δ : ℝ => δ ^ 4 * A6 (X13 - δ) X14 (X15 - δ) (X24 + δ) X25 (X26 + δ) (X35 - δ) X36 (X46 + δ))
    (g := fun e : ℝ => (-X13*X14*X15*X24*X25*X35*e^2 - X13*X14*X15*X24*X25*X46*e^2 - X13*X14*X15*X24*X36*X46*e^2 - X13*X14*X15*X24*X36*e - X13*X14*X15*X25*X35*X36*e^2 - X13*X14*X15*X25*X35*e + X13*X14*X15*X25*X36*e - X13*X14*X15*X25*X46*e - X13*X14*X15*X35*X36*X46*e^2 - X13*X14*X15*X35*X36*e + X13*X14*X24*X25*X35*e + X13*X14*X24*X25*X46*e - X13*X14*X24*X26*X36*X46*e^2 - X13*X14*X24*X26*X36*e + X13*X14*X25*X35*X36*e + X13*X14*X25*X35 - X13*X14*X25*X36 + X13*X14*X25*X46 - X13*X14*X26*X35*X36*X46*e^2 - X13*X14*X26*X35*X36*e - X13*X15*X25*X26*X35*X36*e^2 + X13*X15*X25*X26*X36*e - X13*X15*X25*X35*X36*e + X13*X15*X25*X36 - X13*X25*X26*X35*X36*X46*e^2 + X13*X25*X26*X36*X46*e - X13*X25*X35*X36*X46*e + X13*X25*X36*X46 - X14*X15*X24*X25*X26*X35*e^2 - X14*X15*X24*X25*X26*X46*e^2 + X14*X15*X24*X36*X46*e + X14*X15*X24*X36 - X14*X15*X25*X26*X35*e - X14*X15*X25*X26*X46*e + X14*X15*X25*X35*X36*e - X14*X15*X25*X36 + X14*X15*X35*X36*X46*e + X14*X15*X35*X36 + X14*X24*X25*X26*X35*e - X14*X24*X25*X26*X36*X46*e^2 - X14*X24*X25*X26*X36*e + X14*X24*X25*X26*X46*e - X14*X24*X25*X36*X46*e - X14*X24*X25*X36 + X14*X24*X26*X36*X46*e + X14*X24*X26*X36 + X14*X25*X26*X35 - X14*X25*X26*X36*X46*e - X14*X25*X26*X36 + X14*X25*X26*X46 - X14*X25*X35*X36 - X14*X25*X36*X46 + X14*X26*X35*X36*X46*e + X14*X26*X35*X36 - X15*X24*X25*X26*X35*X36*e^2 + X15*X24*X25*X26*X36*e - X15*X24*X25*X35*X36*e + X15*X24*X25*X36 - X24*X25*X26*X35*X36*X46*e^2 + X24*X25*X26*X36*X46*e - X24*X25*X35*X36*X46*e + X24*X25*X36*X46) / (X14 * X25 * X36 * ((-X13) * e + 1) * ((-X15) * e + 1) * (X24 * e + 1) * (X26 * e + 1) * ((-X35) * e + 1) * (X46 * e + 1))) ?_ ?_
  · convert key using 2
    simp only [A6N]; field_simp; ring
  · apply ContinuousAt.div (by fun_prop) (by fun_prop)
    simp [*]
  · filter_upwards [eventually_gt_atTop (|X13| + |X15| + |X24| + |X26| + |X35| + |X46| + 1)] with δ hδ
    have hδ0 : δ ≠ 0 := by
      intro h; rw [h] at hδ; linarith [abs_nonneg X13, abs_nonneg X15, abs_nonneg X24,
          abs_nonneg X26, abs_nonneg X35, abs_nonneg X46]
