/-- [H] §4.1: A6^NLSM vanishes on the skinny rectangle at index 1: c_{1,j} = 0 for all j
  non-adjacent. -/
theorem nlsm6_zero_1 {X13 X14 X15 X24 X25 X26 X35 X36 X46 : ℝ} (h14 : X14 ≠ 0) (h25 : X25 ≠ 0) (h36 : X36 ≠ 0)
    (hc0 : X13 - X14 + X24 = 0) (hc1 : X14 - X15 - X24 + X25 = 0) (hc2 : X15 - X25 + X26 = 0) :
    A6N X13 X14 X15 X24 X25 X26 X35 X36 X46 = 0 := by
  have e0 : X13 = -X26 := by linarith
  have e1 : X15 = X25 - X26 := by linarith
  have e2 : X24 = X14 + X26 := by linarith
  subst e0 e1 e2
  simp only [A6N]
  field_simp
  ring

