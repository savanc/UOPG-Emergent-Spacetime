def k3p_d : ℤ := 1

/-- The k3p rows are exactly the coefficient comparison generated from `ms3` (cyclic, then reversal with σ = 1). -/
theorem k3p_rows_gen : fRows ms3 cycInv 1 ++ fRows ms3 rho (1) = k3p_Mr := by decide +kernel

/-- Kernel check of the list certificate (`certL 112 56 10`). -/
theorem k3p_cert : certL 112 56 10 k3p_Mr k3p_Mc k3p_Kr k3p_Kc k3p_Pr k3p_Qr k3p_Qc k3p_d = true := by
  decide +kernel

/-- **Formal dimension 10** for k = 3, σ = 1 (the value `rank_count.py` prints for the 40 sampled points). -/
theorem k3p_finrank : Module.finrank ℚ (LinearMap.ker
    (cq (rowsM 112 56 (fRows ms3 cycInv 1 ++ fRows ms3 rho (1)))).mulVecLin) = 10 := by
  rw [k3p_rows_gen]; exact finrank_of_certL k3p_cert

/-- Every certified kernel vector for k3p is a cyclic-invariant polynomial with reversal sign σ = 1. -/
theorem k3p_inv : ∀ c ∈ k3p_Kc, (∀ x : Fin 5 → R, evalPoly c ms3 (fun i => x (i + 1)) = evalPoly c ms3 x) ∧
    (∀ x : Fin 5 → R, evalPoly c ms3 (fun i => x (3 - i)) = (1) * evalPoly c ms3 x) := by
  intro c hc
  simp only [k3p_Kc, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    refine ⟨fun x => ?_, fun x => ?_⟩ <;>
    simp [evalPoly, ms3] <;> ring

/-- **Tie (k3p)**: each certified kernel vector gives `N = eps·f(X)` whose cyclic, reversal and parity rows
  vanish at every point with momentum conservation (not only the 40 sampled points). -/
theorem k3p_N_rows (c : List ℤ) (hc : c ∈ k3p_Kc) (P1 P2 P3 P4 : Matrix (Fin 2) (Fin 2) R) :
    NN c ms3 P2 P3 P4 (-(P1 + P2 + P3 + P4)) - NN c ms3 P1 P2 P3 P4 = 0 ∧
    NN c ms3 (-(P1 + P2 + P3 + P4)) P4 P3 P2 - (1) * NN c ms3 P1 P2 P3 P4 = 0 ∧
    NN c ms3 P1ᵀ P2ᵀ P3ᵀ P4ᵀ + NN c ms3 P1 P2 P3 P4 = 0 :=
  N_rows_of_inv c ms3 _ (k3p_inv c hc).1 (k3p_inv c hc).2 P1 P2 P3 P4

