/-- The k3m rows are exactly the coefficient comparison generated from `ms3` (cyclic, then reversal with σ = -1). -/
theorem k3m_rows_gen : fRows ms3 cycInv 1 ++ fRows ms3 rho (-1) = k3m_Mr := by decide +kernel

/-- Kernel check of the list certificate (`certL 112 56 2`). -/
theorem k3m_cert : certL 112 56 2 k3m_Mr k3m_Mc k3m_Kr k3m_Kc k3m_Pr k3m_Qr k3m_Qc k3m_d = true := by
  decide +kernel

/-- **Formal dimension 2** for k = 3, σ = -1 (the value `rank_count.py` prints for the 40 sampled points). -/
theorem k3m_finrank : Module.finrank ℚ (LinearMap.ker
    (cq (rowsM 112 56 (fRows ms3 cycInv 1 ++ fRows ms3 rho (-1)))).mulVecLin) = 2 := by
  rw [k3m_rows_gen]; exact finrank_of_certL k3m_cert

/-- Every certified kernel vector for k3m is a cyclic-invariant polynomial with reversal sign σ = -1. -/
theorem k3m_inv : ∀ c ∈ k3m_Kc, (∀ x : Fin 5 → R, evalPoly c ms3 (fun i => x (i + 1)) = evalPoly c ms3 x) ∧
    (∀ x : Fin 5 → R, evalPoly c ms3 (fun i => x (3 - i)) = (-1) * evalPoly c ms3 x) := by
  intro c hc
  simp only [k3m_Kc, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl <;>
    refine ⟨fun x => ?_, fun x => ?_⟩ <;>
    simp [evalPoly, ms3] <;> ring

/-- **Tie (k3m)**: each certified kernel vector gives `N = eps·f(X)` whose cyclic, reversal and parity rows
  vanish at every point with momentum conservation (not only the 40 sampled points). -/
theorem k3m_N_rows (c : List ℤ) (hc : c ∈ k3m_Kc) (P1 P2 P3 P4 : Matrix (Fin 2) (Fin 2) R) :
    NN c ms3 P2 P3 P4 (-(P1 + P2 + P3 + P4)) - NN c ms3 P1 P2 P3 P4 = 0 ∧
    NN c ms3 (-(P1 + P2 + P3 + P4)) P4 P3 P2 - (-1) * NN c ms3 P1 P2 P3 P4 = 0 ∧
    NN c ms3 P1ᵀ P2ᵀ P3ᵀ P4ᵀ + NN c ms3 P1 P2 P3 P4 = 0 :=
  N_rows_of_inv c ms3 _ (k3m_inv c hc).1 (k3m_inv c hc).2 P1 P2 P3 P4

theorem ms2_ok : monoOK 2 ms2 = true := by decide +kernel
theorem ms3_ok : monoOK 3 ms3 = true := by decide +kernel

/-- Planted: the single monomial `X₀` (degree 1, inside `ms2`) is not cyclic-invariant. -/
theorem planted_X0_not_cyclic :
    evalPoly (R := ℚ) [0, 1] ms2 (fun i => (fun j : Fin 5 => if j = 0 then (1 : ℚ) else 0) (i + 1)) ≠
      evalPoly [0, 1] ms2 (fun j : Fin 5 => if j = 0 then (1 : ℚ) else 0) := by
  simp [evalPoly, ms2]

