/-- Every certified kernel vector for k2p is a cyclic-invariant polynomial with reversal sign σ = 1. -/
theorem k2p_inv : ∀ c ∈ k2p_Kc, (∀ x : Fin 5 → R, evalPoly c ms2 (fun i => x (i + 1)) = evalPoly c ms2 x) ∧
    (∀ x : Fin 5 → R, evalPoly c ms2 (fun i => x (3 - i)) = (1) * evalPoly c ms2 x) := by
  intro c hc
  simp only [k2p_Kc, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl <;>
    refine ⟨fun x => ?_, fun x => ?_⟩ <;>
    simp [evalPoly, ms2] <;> ring

/-- **Tie (k2p)**: each certified kernel vector gives `N = eps·f(X)` whose cyclic, reversal and parity rows
  vanish at every point with momentum conservation (not only the 40 sampled points). -/
theorem k2p_N_rows (c : List ℤ) (hc : c ∈ k2p_Kc) (P1 P2 P3 P4 : Matrix (Fin 2) (Fin 2) R) :
    NN c ms2 P2 P3 P4 (-(P1 + P2 + P3 + P4)) - NN c ms2 P1 P2 P3 P4 = 0 ∧
    NN c ms2 (-(P1 + P2 + P3 + P4)) P4 P3 P2 - (1) * NN c ms2 P1 P2 P3 P4 = 0 ∧
    NN c ms2 P1ᵀ P2ᵀ P3ᵀ P4ᵀ + NN c ms2 P1 P2 P3 P4 = 0 :=
  N_rows_of_inv c ms2 _ (k2p_inv c hc).1 (k2p_inv c hc).2 P1 P2 P3 P4

