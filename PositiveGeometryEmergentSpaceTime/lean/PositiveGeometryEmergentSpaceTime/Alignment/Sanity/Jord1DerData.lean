/-- Entry `(a, b)` of a sparse matrix. -/
def spGet (s : List (ℕ × ℕ × ℤ)) : ℕ → ℕ → ℤ := fun a b =>
  match s.find? (fun p => p.1 == a && p.2.1 == b) with
  | some p => p.2.2
  | none => 0

/-- Integer rows of the basis derivations (dense, from `Sp`). -/
def Bm : List (List (List ℤ)) :=
  Sp.map fun s => (List.range 27).map fun a => (List.range 27).map fun b => spGet s a b

/-- Columns of the basis derivations (dense, from `Sp`). -/
def BmC : List (List (List ℤ)) :=
  Sp.map fun s => (List.range 27).map fun a => (List.range 27).map fun b => spGet s b a


/-- Basis derivation `t`, integer rows. -/
def Bt (t : ℕ) : List (List ℤ) := Bm.getD t []
/-- Basis derivation `t`, integer columns. -/
def BCt (t : ℕ) : List (List ℤ) := BmC.getD t []
/-- Integer entry `u = 27a + b` of a row list. -/
def Dvz (L : List (List ℤ)) (u : ℕ) : ℤ := (L.getD (u / 27) []).getD (u % 27) 0

/-- Checks for basis derivation `t`: transpose, derivation, `Fr`-entries `dB[t]·δ`, `dB[t] > 0`. -/
def derOK (t : ℕ) : Bool :=
  tposL 27 27 (Bt t) (BCt t) && derS (Bt t) (BCt t) &&
    (List.range 52).all (fun s => Dvz (Bt t) (Fr.getD s 0) == if s = t then (dB.getD t 1 : ℤ) else 0) &&
    decide (0 < dB.getD t 1)


