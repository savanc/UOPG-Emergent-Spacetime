theorem cover (u : ℕ) (hu : u < 729) : u ∈ knownOf 28 := by
  have key : ∀ r < 9, (List.range' (81 * r) 81).all (fun u => (knownOf 28).contains u) = true := by
    intro r hr
    interval_cases r
    · exact cov_0
    · exact cov_1
    · exact cov_2
    · exact cov_3
    · exact cov_4
    · exact cov_5
    · exact cov_6
    · exact cov_7
    · exact cov_8
  have h := key (u / 81) (by omega)
  simp only [List.all_eq_true, List.mem_range', List.contains_iff_mem] at h
  exact h u ⟨u % 81, by omega, by omega⟩

/-- **Upper bound.** A derivation vanishing on the 52 entries `Fr` vanishes. -/
theorem peel_zero (D : Mat) (hD : IsDer D) (hF : ∀ v ∈ Fr, Dv D v = 0) : ∀ u < 729, Dv D u = 0 :=
  fun u hu => known_zero D hD hF 28 le_rfl u (cover u hu)

