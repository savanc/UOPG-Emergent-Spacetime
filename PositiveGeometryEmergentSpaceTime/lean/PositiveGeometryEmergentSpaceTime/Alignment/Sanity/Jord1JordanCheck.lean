/-- Sparse linearised Jordan defect `(b_i b_l)(b_j b_k) − b_i (b_l (b_j b_k))`. -/
def tS (i j k l : ℕ) : List (ℕ × ℤ) :=
  prodS (prodS (eB i) (eB l)) (prodS (eB j) (eB k)) ++
    smulS (-1) (prodS (eB i) (prodS (eB l) (prodS (eB j) (eB k))))
/-- Cyclic sum of the defect over `(i, j, k)`. -/
def cS (i j k l : ℕ) : List (ℕ × ℤ) := tS i j k l ++ tS j k i l ++ tS k i j l
/-- A sparse vector is zero in all 27 coordinates. -/
def zS (u : List (ℕ × ℤ)) : Bool := (List.range 27).all (fun m => coefS u m == 0)
/-- Check for one pair `(i, j)`: all `k ≥ j`, all `l`. -/
