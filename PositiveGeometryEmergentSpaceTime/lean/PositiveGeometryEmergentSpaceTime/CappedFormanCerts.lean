/-! ## Prism7H: edge (0, 1), 2-faces through it of sizes (4, 7), D = 3; matching cost 4, κ = 1 − 4/4 = 0 = B -/
namespace Prism7H
abbrev V := Fin 14
def nbrT : List (List Nat) := [[1, 6, 7], [0, 2, 8], [1, 3, 9], [2, 4, 10], [3, 5, 11], [4, 6, 12], [0, 5, 13], [0, 8, 13], [1, 7, 9], [2, 8, 10], [3, 9, 11], [4, 10, 12], [5, 11, 13], [6, 7, 12]]
def nbrs (i : V) : List V := (nbrT.getD i.val []).map fun j => (Fin.ofNat 14 j)
def adj (i j : V) : Bool := (nbrs i).contains j
/-- Symmetric, loop-free, 3-regular adjacency. -/
theorem adj_ok : ∀ i j : V, (adj i j = adj j i) ∧ adj i i = false ∧ (nbrs i).length = 3 := by decide +kernel
def NA : List V := [0, 1, 6, 7]
def NB : List V := [1, 0, 2, 8]
theorem nbhd : NA = 0 :: nbrs 0 ∧ NB = 1 :: nbrs 1 ∧ adj 0 1 = true := by decide +kernel
def ws : List (V × List V) := [(0, []), (1, []), (6, [0, 1, 2]), (7, [8])]
def phi (i : V) : Int := ([0, -1, -2, -2, -1, 0, 1, 1, 0, -1, -2, -2, -1, 0] : List Int).getD i.val 0
theorem phi_lip : ∀ i : V, (nbrs i).all (fun j => decide (phi i - phi j ≤ 1)) = true := by decide +kernel
theorem phi_gap : (NA.map phi).sum - (NB.map phi).sum = 4 := by decide +kernel
theorem ws_ok : (ws.all fun p => walkOk adj (p.1 :: p.2)) = true ∧ (ws.map Prod.fst).Perm NA ∧
    (ws.map fun p => fin p.1 p.2).Perm NB ∧ (ws.map fun p => (p.2.length : Int)).sum = 4 := by
  refine ⟨by decide +kernel, ?_, ?_, by decide +kernel⟩ <;> exact List.perm_iff_count.mpr (by decide +kernel)
/-- Minimum walk-realised perfect-matching cost between the closed neighbourhoods is exactly 4. -/
theorem cost_exact :
    (∃ ws : List (V × List V), (∀ p ∈ ws, walkOk adj (p.1 :: p.2) = true) ∧ (ws.map Prod.fst).Perm NA ∧
      (ws.map fun p => fin p.1 p.2).Perm NB ∧ (ws.map fun p => (p.2.length : Int)).sum = 4) ∧
    (∀ ws : List (V × List V), (∀ p ∈ ws, walkOk adj (p.1 :: p.2) = true) → (ws.map Prod.fst).Perm NA →
      (ws.map fun p => fin p.1 p.2).Perm NB → 4 ≤ (ws.map fun p => (p.2.length : Int)).sum) := by
  obtain ⟨h1, h2, h3, h4⟩ := ws_ok
  refine ⟨⟨ws, fun p hp => List.all_eq_true.mp h1 p hp, h2, h3, h4⟩, ?_⟩
  intro ws hw hA hB
  have hl : ∀ i j : V, adj i j = true → phi i - phi j ≤ 1 := by
    intro i j hij
    have := List.all_eq_true.mp (phi_lip i) j (by simpa [adj] using hij)
    simpa using this
  have := cost_lower adj phi hl ws hw
  rw [(hA.map phi).sum_eq, (hB.map phi).sum_eq, phi_gap] at this
  exact this
/-- κ = 1 − cost/(D+1) equals the capped-Forman bound B = 1 − Σ min(3, k−3)/(D+1). -/
theorem kappa_eq_B : (1 : ℚ) - 4 / 4 = 1 - ((min 3 (4 - 3) + min 3 (7 - 3) : ℕ) : ℚ) / 4 := by norm_num
end Prism7H

