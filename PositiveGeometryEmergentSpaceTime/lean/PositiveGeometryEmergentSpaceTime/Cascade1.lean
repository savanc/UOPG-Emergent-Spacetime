/-! ## n = 4 -/

/-- S3 at n = 4 on the line X13 + X24 = s: the amplitude 1/(x − a) + 1/(y − b) vanishes on the whole line
(off poles) iff a + b = s. -/
theorem zero4_iff (a b s : ℚ) :
    (∀ x y : ℚ, x + y = s → x - a ≠ 0 → y - b ≠ 0 → 1 / (x - a) + 1 / (y - b) = 0) ↔ a + b = s := by
  constructor
  · intro H
    by_contra hne
    have hd : s - a - b ≠ 0 := fun h => hne (by linarith)
    have h := H (a + 2 * (s - a - b)) (s - (a + 2 * (s - a - b))) (by ring)
      (by intro h0; apply hd; linarith) (by intro h0; apply hd; linarith)
    have e1 : a + 2 * (s - a - b) - a = 2 * (s - a - b) := by ring
    have e2 : s - (a + 2 * (s - a - b)) - b = -(s - a - b) := by ring
    rw [e1, e2] at h
    field_simp at h
    exact hd (by linarith)
  · intro h x y hxy hx hy
    have e : y - b = -(x - a) := by linarith
    rw [e, one_div_neg_eq_neg_one_div]; ring

/-- E0, n = 4, S4: the δ-line μ13 = −μ24 meets the non-tachyonic cone only at 0. -/
theorem e0_n4_collapse (a b : ℚ) (h : a + b = 0) (ha : 0 ≤ a) (hb : 0 ≤ b) : a = 0 ∧ b = 0 :=
  ⟨by linarith, by linarith⟩

/-- E0, n = 4: hidden zeros on {c13 = 0} (X13 + X24 = 0) iff μ13 + μ24 = 0 (the 2312.16282 §7.1
  δ-line). -/
theorem e0_n4_zero_iff (μ13 μ24 : ℚ) :
    (∀ X13 X24 : ℚ,
        X13 + X24 = 0 → X13 - μ13 ≠ 0 → X24 - μ24 ≠ 0 → 1 / (X13 - μ13) + 1 / (X24 - μ24) = 0)
      ↔ μ13 + μ24 = 0 := zero4_iff μ13 μ24 0

/-- EM, n = 4: zeros on both loci {c13 = 0} = {X13 + X24 = m2 + m4} and {c24 = 0} = {X13 + X24 = m1 + m3}
iff the two S3 relations. -/
theorem em_n4_zero_iff (μ13 μ24 m1 m2 m3 m4 : ℚ) :
    ((∀ X13 X24 : ℚ, X13 + X24 - m2 - m4 = 0 → X13 - μ13 ≠ 0 → X24 - μ24 ≠ 0 →
        1 / (X13 - μ13) + 1 / (X24 - μ24) = 0) ∧
     (∀ X13 X24 : ℚ, X13 + X24 - m1 - m3 = 0 → X13 - μ13 ≠ 0 → X24 - μ24 ≠ 0 →
        1 / (X13 - μ13) + 1 / (X24 - μ24) = 0))
      ↔ (μ13 + μ24 - m2 - m4 = 0 ∧ m1 - m2 + m3 - m4 = 0) := by
  have h1 := zero4_iff μ13 μ24 (m2 + m4)
  have h2 := zero4_iff μ13 μ24 (m1 + m3)
  constructor
  · rintro ⟨H1, H2⟩
    have a1 := h1.1 (fun x y hxy => H1 x y (by linarith))
    have a2 := h2.1 (fun x y hxy => H2 x y (by linarith))
    constructor <;> linarith
  · rintro ⟨r1, r2⟩
    refine ⟨fun x y hxy => h1.2 (by linarith) x y (by linarith),
        fun x y hxy => h2.2 (by linarith) x y (by linarith)⟩

/-! ## n = 5 cores (massless identities in y; 2312.16282 eqs. 3.1, 3.3, 3.5 reproduced) -/

/-- eq. (3.1): the S2 output at n = 5 (triangulation sum), arguments (y13, y14, y24, y25, y35). -/
noncomputable def A5 (y13 y14 y24 y25 y35 : ℚ) : ℚ :=
  1 / (y13 * y14) + 1 / (y24 * y25) + 1 / (y13 * y35) + 1 / (y14 * y24) + 1 / (y25 * y35)

/-- Massless n = 5 core (eq. (3.1) form): for nonzero arguments with `d = a + b` and `f = −a`, `A5 a
  d b f e = 0`. -/
theorem core_zero (a d b f e : ℚ) (ha : a ≠ 0) (hd : d ≠ 0) (hb : b ≠ 0) (hf : f ≠ 0) (he : e ≠ 0)
    (h1 : d = a + b) (h2 : f = -a) : A5 a d b f e = 0 := by
  subst h1 h2; unfold A5; field_simp; ring

/-- Massless n = 5 core: for nonzero arguments with `b = d + f`, `A5 = (1/a + 1/f)(1/d + 1/e)`. -/
theorem core_split33 (a d b f e : ℚ) (ha : a ≠ 0) (hd : d ≠ 0) (hb : b ≠ 0) (hf : f ≠ 0) (he : e ≠ 0)
    (h : b = d + f) : A5 a d b f e = (1 / a + 1 / f) * (1 / d + 1 / e) := by
  subst h; unfold A5; field_simp; ring

/-- Massless n = 5 core: for nonzero arguments with `d = a + b`, `A5 = (1/a + 1/f)(1/b + 1/e)`. -/
theorem core_split35 (a d b f e : ℚ) (ha : a ≠ 0) (hd : d ≠ 0) (hb : b ≠ 0) (hf : f ≠ 0) (he : e ≠ 0)
    (h : d = a + b) : A5 a d b f e = (1 / a + 1 / f) * (1 / b + 1 / e) := by
  subst h; unfold A5; field_simp; ring

/-- Only-if core: if A5 vanishes on the whole (shifted) locus d = a + b + α, f = β − a, then α = β =
  0. -/
theorem core_only_if (α β : ℚ)
    (H : ∀ a b e : ℚ, a ≠ 0 → b ≠ 0 → e ≠ 0 → a + b + α ≠ 0 → β - a ≠ 0 →
      A5 a (a + b + α) b (β - a) e = 0) : α = 0 ∧ β = 0 := by
  -- β: compare e = 1 and e = 2 at a = |β| + 1, b = |α| + a + 1
  have hβ : β = 0 := by
    set a : ℚ := |β| + 1 with ha_def
    set b : ℚ := |α| + a + 1 with hb_def
    have hapos : 0 < a := by positivity
    have ha : a ≠ 0 := hapos.ne'
    have hb : b ≠ 0 := by positivity
    have hd : a + b + α ≠ 0 := by have := neg_abs_le α; intro h; linarith
    have hf : β - a ≠ 0 := by have := le_abs_self β; intro h; linarith
    have h1 := H a b 1 ha hb one_ne_zero hd hf
    have h2 := H a b 2 ha hb two_ne_zero hd hf
    unfold A5 at h1 h2
    have hu : 1 / a + 1 / (β - a) = 0 := by
      have e1 : 1 / (a * 1) = 1 / a := by rw [mul_one]
      have e2 : 1 / ((β - a) * 1) = 1 / (β - a) := by rw [mul_one]
      have e3 : 1 / (a * 2) = (1 / a) / 2 := by rw [div_div]
      have e4 : 1 / ((β - a) * 2) = (1 / (β - a)) / 2 := by rw [div_div]
      rw [e1, e2] at h1; rw [e3, e4] at h2; linarith
    rw [div_add_div _ _ ha hf, div_eq_zero_iff] at hu
    rcases hu with h | h
    · linarith
    · exact absurd h (mul_ne_zero ha hf)
  refine ⟨?_, hβ⟩
  subst hβ
  set b : ℚ := |α| + 1 with hb_def
  have hb : b ≠ 0 := by positivity
  have hd : 1 + b + α ≠ 0 := by have := neg_abs_le α; intro h; linarith
  have h := H 1 b 1 one_ne_zero hb one_ne_zero hd (by norm_num)
  have key : A5 1 (1 + b + α) b (0 - 1) 1 = -α / (b * (1 + b + α)) := by
    unfold A5; field_simp; ring
  rw [key, div_eq_zero_iff] at h
  rcases h with h | h
  · linarith
  · exact absurd h (mul_ne_zero hb hd)

