/-- S3 condition at n = 5: A5(X − μ) vanishes on all five physical zero loci Z_i. -/
def Zeros5 (μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 : ℚ) : Prop :=
  (∀ X13 X14 X24 X25 X35 : ℚ, X13 - X14 + X24 - m2 = 0 → X14 - X24 + X25 - m5 = 0 →
      (X13 - μ13) ≠ 0 → (X14 - μ14) ≠ 0 → (X24 - μ24) ≠ 0 → (X25 - μ25) ≠ 0 → (X35 - μ35) ≠ 0 → A5 (X13 - μ13) (X14 - μ14) (X24 - μ24) (X25 - μ25) (X35 - μ35) = 0) ∧
  (∀ X13 X14 X24 X25 X35 : ℚ, X24 - X25 + X35 - m3 = 0 → X13 + X25 - X35 - m1 = 0 →
      (X13 - μ13) ≠ 0 → (X14 - μ14) ≠ 0 → (X24 - μ24) ≠ 0 → (X25 - μ25) ≠ 0 → (X35 - μ35) ≠ 0 → A5 (X13 - μ13) (X14 - μ14) (X24 - μ24) (X25 - μ25) (X35 - μ35) = 0) ∧
  (∀ X13 X14 X24 X25 X35 : ℚ, -X13 + X14 + X35 - m4 = 0 → X13 - X14 + X24 - m2 = 0 →
      (X13 - μ13) ≠ 0 → (X14 - μ14) ≠ 0 → (X24 - μ24) ≠ 0 → (X25 - μ25) ≠ 0 → (X35 - μ35) ≠ 0 → A5 (X13 - μ13) (X14 - μ14) (X24 - μ24) (X25 - μ25) (X35 - μ35) = 0) ∧
  (∀ X13 X14 X24 X25 X35 : ℚ, X14 - X24 + X25 - m5 = 0 → X24 - X25 + X35 - m3 = 0 →
      (X13 - μ13) ≠ 0 → (X14 - μ14) ≠ 0 → (X24 - μ24) ≠ 0 → (X25 - μ25) ≠ 0 → (X35 - μ35) ≠ 0 → A5 (X13 - μ13) (X14 - μ14) (X24 - μ24) (X25 - μ25) (X35 - μ35) = 0) ∧
  (∀ X13 X14 X24 X25 X35 : ℚ, X13 + X25 - X35 - m1 = 0 → -X13 + X14 + X35 - m4 = 0 →
      (X13 - μ13) ≠ 0 → (X14 - μ14) ≠ 0 → (X24 - μ24) ≠ 0 → (X25 - μ25) ≠ 0 → (X35 - μ35) ≠ 0 → A5 (X13 - μ13) (X14 - μ14) (X24 - μ24) (X25 - μ25) (X35 - μ35) = 0)

/-- The five live S3 relations (cascade1_live.json, EM-n5). -/
def Rel5 (μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 : ℚ) : Prop :=
  -m3 + m4 - m5 + μ13 = 0 ∧ -m1 + m2 - m3 + μ14 = 0 ∧ -m1 - m4 + m5 + μ24 = 0 ∧ -m2 + m3 - m4 + μ25 = 0 ∧ m1 - m2 - m5 + μ35 = 0

/-- n = 5, EM: hidden zeros on all Z_i ⟺ the five relations (both directions PROVED). -/
theorem em_n5_zero_iff (μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 : ℚ) : Zeros5 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 ↔ Rel5 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 := by
  unfold Zeros5 Rel5
  constructor
  · rintro ⟨H1, H2, H3, H4, H5⟩
    obtain ⟨a1, b1⟩ := zero5_only_if_1 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 H1
    obtain ⟨a2, b2⟩ := zero5_only_if_2 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 H2
    obtain ⟨a3, b3⟩ := zero5_only_if_3 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 H3
    obtain ⟨a4, b4⟩ := zero5_only_if_4 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 H4
    obtain ⟨a5, b5⟩ := zero5_only_if_5 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 H5
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> linarith
  · rintro ⟨r0, r1, r2, r3, r4⟩
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> intro X13 X14 X24 X25 X35 hc0 hc1 h13 h14 h24 h25 h35
    · exact zero5_of_rel_1 X13 X14 X24 X25 X35 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 r0 r1 r2 r3 r4 hc0 hc1 h13 h14 h24 h25 h35
    · exact zero5_of_rel_2 X13 X14 X24 X25 X35 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 r0 r1 r2 r3 r4 hc0 hc1 h13 h14 h24 h25 h35
    · exact zero5_of_rel_3 X13 X14 X24 X25 X35 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 r0 r1 r2 r3 r4 hc0 hc1 h13 h14 h24 h25 h35
    · exact zero5_of_rel_4 X13 X14 X24 X25 X35 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 r0 r1 r2 r3 r4 hc0 hc1 h13 h14 h24 h25 h35
    · exact zero5_of_rel_5 X13 X14 X24 X25 X35 μ13 μ14 μ24 μ25 μ35 m1 m2 m3 m4 m5 r0 r1 r2 r3 r4 hc0 hc1 h13 h14 h24 h25 h35

/-- n = 5, E0 (m_i = 0): hidden zeros force every offset to vanish (Θ_3 = {0}, BELOW). -/
theorem e0_n5_zero_iff (μ13 μ14 μ24 μ25 μ35 : ℚ) :
    Zeros5 μ13 μ14 μ24 μ25 μ35 0 0 0 0 0 ↔ (μ13 = 0 ∧ μ14 = 0 ∧ μ24 = 0 ∧ μ25 = 0 ∧ μ35 = 0) := by
  rw [em_n5_zero_iff]; unfold Rel5
  constructor
  · rintro ⟨r0, r1, r2, r3, r4⟩; refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> linarith
  · rintro ⟨r0, r1, r2, r3, r4⟩; refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> linarith


